{
  "name": "pdf-local",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Processamento de PDFs 100% no navegador — privacidade total, zero upload",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "tsc --noEmit && node scripts/generate-sitemap.mjs && vite build && node scripts/prerender.mjs",
    "build:skip-prerender": "tsc --noEmit && node scripts/generate-sitemap.mjs && vite build",
    "prerender": "node scripts/prerender.mjs",
    "validate:prerender": "node scripts/validate-prerender.mjs",
    "deploy:cf": "wrangler deploy",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:pwa": "node scripts/gen-pwa-icons.mjs",
    "tesseract:setup": "node scripts/setup-tesseract.mjs",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "html2pdf.js": "^0.10.2",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
